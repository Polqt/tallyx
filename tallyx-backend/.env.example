# Server
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:8081

# PostgreSQL
# Use DATABASE_URL in production hosts such as Neon, Railway, Render, or Supabase.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tallyx
DB_USER=postgres
DB_PASSWORD=your_password
# Set to "false" to disable TLS cert verification (e.g. self-signed certs). Default is strict.
DB_SSL_REJECT_UNAUTHORIZED=

# JWT
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Stellar (Soroban)
STELLAR_NETWORK=mainnet
STELLAR_RPC_URL=https://mainnet.sorobanrpc.com
CREDIT_CONTRACT_ID=your_mainnet_contract_id_here
USDC_CONTRACT_ID=CCW67TSZV3SSS2HXMBQ5JFGCKJNXKZM7UQUWUZPUTHXSTZLEO7SJMI75

# Server-side keypair used to sign Soroban contract invocations.
# This is the relay/fee-payer account, NOT the end user's Freighter wallet.
STELLAR_SECRET_KEY=your_secret_key_here
