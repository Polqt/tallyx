# Server
PORT=3000
NODE_ENV=development

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tallyx
DB_USER=postgres
DB_PASSWORD=your_password

# JWT
JWT_SECRET=your_jwt_secret_minimum_32_characters_long
JWT_EXPIRES_IN=7d

# Stellar (Soroban)
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
CREDIT_CONTRACT_ID=your_contract_id_here
# Server-side keypair used to sign Soroban contract invocations (must have XLM for fees).
# This is the relay/fee-payer account — NOT the end user's Freighter wallet.
STELLAR_SECRET_KEY=your_secret_key_here
